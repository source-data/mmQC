# Copy to .env in the project root.

# ImageMagick, for figure and document conversion. macOS + Homebrew:
# /opt/homebrew/opt/imagemagick (Linux usually needs nothing).
MAGICK_HOME=

# Agent runtime keys: ANTHROPIC_API_KEY for `mmqc run --provider claude-sdk`
# (the default), OPENAI_API_KEY for `--provider openai`.
ANTHROPIC_API_KEY=
OPENAI_API_KEY=

# Device for the scorer's sentence embeddings: cpu, cuda or mps.
DEVICE=cpu

# Optional. Model for agent sessions when neither --model nor the
# checklist's model-defaults.yaml names one.
# SODA_MMQC_AGENTIC_MODEL=
# Optional. Where agent runtimes are assembled (defaults to a temp dir).
# SODA_MMQC_AGENTIC_RUNTIME_DIR=
# Optional. Score against a pinned gold snapshot; see soda_mmqc/gold.py.
# SODA_MMQC_GOLD_DIR=

# Single-prompt layer (soda_mmqc/lib/api.py): provider and response cache.
# API_PROVIDER=openai
# SODA_MMQC_CACHE_DIR=

# Optional. Langfuse, as the curation app's prompt source.
# LANGFUSE_PUBLIC_KEY=
# LANGFUSE_SECRET_KEY=
# LANGFUSE_BASE_URL=
