{
    "format": {
        "type": "json_schema",
        "name": "plot-axis-units",
        "schema": {
            "type": "object",
            "properties": {
                "outputs": {
                    "type": "array",
                    "items": {
                        "type": "object",
                        "properties": {
                            "panel_label": {
                                "type": "string",
                                "description": "Label of the panel (e.g., A, B, C)"
                            },
                            "is_a_plot_with_axes": {
                                "type": "string",
                                "enum": ["yes", "no"],
                                "description": "Whether the panel is a plot of quantitative data with drawn axes; pie charts, heat maps and sequence alignments are not"
                            },
                            "units_provided": {
                                "type": "array",
                                "items": {
                                    "type": "object",
                                    "properties": {
                                        "axis": {
                                            "type": "string",
                                            "enum": ["x", "y", "z"],
                                            "description": "The axis to be labeled"
                                        },
                                        "answer": {
                                            "type": "string",
                                            "enum": ["yes", "no", "not_required"],
                                            "description": "Whether the units are provided"
                                        }
                                    },
                                    "required": [
                                        "axis",
                                        "answer"
                                    ],
                                    "additionalProperties": false
                                }
                            },
                            "unit_definition_as_provided": {
                                "type": "array",
                                "items": {
                                    "type": "object",
                                    "properties": {
                                        "axis": {
                                            "type": "string",
                                            "enum": ["x", "y", "z"],
                                            "description": "The axis to be labeled"
                                        },
                                        "definition": {
                                            "type": "string",
                                            "description": "A description or quote the text of the caption that defines the units"
                                        }
                                    },
                                    "required": [
                                        "axis",
                                        "definition"
                                    ],
                                    "additionalProperties": false
                                }
                            },
                            "decision": {
                                "type": "string",
                                "enum": ["PASS", "FAIL", "not_applicable"],
                                "description": "Panel-level verdict: PASS if all required axes have adequate units, FAIL if any required axis lacks units, not_applicable if the panel is not a quantitative plot"
                            },
                            "explanation": {
                                "type": "array",
                                "items": {
                                    "type": "object",
                                    "properties": {
                                        "axis": {
                                            "type": "string",
                                            "enum": ["x", "y", "z"],
                                            "description": "The axis to be labeled"
                                        },
                                        "explanation": {
                                            "type": "string",
                                            "description": "Explanation for why the units are missing"
                                        }
                                    },
                                    "required": [
                                        "axis",
                                        "explanation"
                                    ],
                                    "additionalProperties": false
                                }
                            }
                        },
                        "required": [
                            "panel_label",
                            "is_a_plot_with_axes",
                            "units_provided",
                            "unit_definition_as_provided",
                            "decision",
                            "explanation"
                        ],
                        "additionalProperties": false
                    }
                }
            },
            "required": ["outputs"],
            "additionalProperties": false
        },
        "strict": true
    }
}
