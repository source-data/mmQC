{
    "format": {
        "type": "json_schema",
        "name": "plot-gap-labeling",
        "schema": {
            "type": "object",
            "properties": {
                "outputs": {
                    "type": "array",
                    "items": {
                        "type": "object",
                        "properties": {
                            "panel_label": {
                                "type": "string",
                                "description": "Label of the panel (e.g., A, B, C)"
                            },
                            "is_a_plot": {
                                "type": "string",
                                "enum": ["yes", "no"],
                                "description": "Whether the panel contains a quantitative plot with axes"
                            },
                            "tick_sequence_anomaly": {
                                "type": "string",
                                "enum": ["yes", "no", "not_applicable"],
                                "description": "Whether tick labels show an anomalous jump or skip suggesting an axis gap"
                            },
                            "gap_visually_marked": {
                                "type": "string",
                                "enum": ["yes", "no", "not_applicable"],
                                "description": "Whether a detected gap/break is visually marked on the axis; not_applicable when no anomaly"
                            },
                            "decision": {
                                "type": "string",
                                "enum": ["PASS", "FAIL", "N/A"],
                                "description": "Panel-level verdict: FAIL only when a tick-sequence anomaly is present and not visually marked; N/A if not a plot"
                            },
                            "explanation": {
                                "type": "string",
                                "description": "Brief description of the unlabeled gap when decision is FAIL; empty string otherwise"
                            }
                        },
                        "required": [
                            "panel_label",
                            "is_a_plot",
                            "tick_sequence_anomaly",
                            "gap_visually_marked",
                            "decision",
                            "explanation"
                        ],
                        "additionalProperties": false
                    }
                }
            },
            "required": ["outputs"],
            "additionalProperties": false
        },
        "strict": true
    }
}
