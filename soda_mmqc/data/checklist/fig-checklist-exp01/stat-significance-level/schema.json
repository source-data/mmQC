{
    "format": {
        "type": "json_schema",
        "name": "stat-significance-level",
        "schema": {
            "type": "object",
            "properties": {
                "outputs": {
                    "type": "array",
                    "items": {
                        "type": "object",
                        "properties": {
                            "panel_label": {
                                "type": "string",
                                "description": "Label of the panel (e.g., A, B, C)"
                            },
                            "is_a_plot": {
                                "type": "string",
                                "enum": ["yes", "no"],
                                "description": "Whether the figure is a plot"
                            },
                            "significance_level_symbols_on_image": {
                                "type": "array",
                                "items": {
                                    "type": "string"
                                },
                                "description": "Significance level symbols on the image"
                            },
                            "symbols_defined": {
                                "type": "array",
                                "items": {
                                    "type": "string",
                                    "enum": ["yes", "no"]
                                },
                                "description": "Whether each significance level symbol is defined in the image and/or caption"
                            },
                            "symbol_definition": {
                                "type": "array",
                                "items": {
                                    "type": "string"
                                },
                                "description": "Defining text for each significance symbol, transcribed from the image and/or caption; empty string if undefined"
                            },
                            "decision": {
                                "type": "string",
                                "enum": ["PASS", "FAIL", "N/A"],
                                "description": "Panel-level verdict on whether significance levels are adequately defined; N/A when not a plot or no symbols to assess"
                            },
                            "explanation": {
                                "type": "string",
                                "description": "Brief rationale for the decision; empty string when decision is N/A"
                            }
                        },
                        "required": [
                            "panel_label",
                            "is_a_plot",
                            "significance_level_symbols_on_image",
                            "symbols_defined",
                            "symbol_definition",
                            "decision",
                            "explanation"
                        ],
                        "additionalProperties": false
                    }
                }
            },
            "required": ["outputs"],
            "additionalProperties": false
        },
        "strict": true
    }
}
