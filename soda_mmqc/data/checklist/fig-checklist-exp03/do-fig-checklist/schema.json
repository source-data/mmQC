{
  "format": {
    "type": "json_schema",
    "name": "do-fig-checklist",
    "schema": {
      "type": "object",
      "properties": {
        "micrograph-scale-bar": {
          "type": "array",
          "items": {
            "type": "object",
            "properties": {
              "panel_label": {
                "type": "string",
                "description": "Label of the panel (e.g., A, B, C)"
              },
              "micrograph": {
                "type": "string",
                "enum": [
                  "yes",
                  "no"
                ],
                "description": "Whether the panel contains a micrograph or microscopic image"
              },
              "scale_bar_on_image": {
                "type": "string",
                "enum": [
                  "yes",
                  "no",
                  ""
                ],
                "description": "Whether there is a scale bar present on the micrograph"
              },
              "scale_bar_defined_in_caption": {
                "type": "string",
                "enum": [
                  "yes",
                  "no",
                  ""
                ],
                "description": "Whether the scale bar is defined in the caption"
              },
              "from_the_caption": {
                "type": "string",
                "description": "The exact text from the caption that defines the scale bar"
              },
              "scale_bar_defined_in_image": {
                "type": "string",
                "enum": [
                  "yes",
                  "no",
                  ""
                ],
                "description": "Whether the scale bar is defined in the image"
              },
              "from_the_image": {
                "type": "string",
                "description": "The exact text from the image that defines the scale bar"
              }
            },
            "required": [
              "panel_label",
              "micrograph",
              "scale_bar_on_image",
              "scale_bar_defined_in_caption",
              "from_the_caption",
              "scale_bar_defined_in_image",
              "from_the_image"
            ],
            "additionalProperties": false
          }
        },
        "individual-data-points": {
          "type": "array",
          "items": {
            "type": "object",
            "properties": {
              "panel_label": {
                "type": "string",
                "description": "Label of the panel (e.g., A, B, C)"
              },
              "plot": {
                "type": "string",
                "enum": [
                  "yes",
                  "no"
                ],
                "description": "Whether the panel is a plot"
              },
              "individual_values": {
                "type": "string",
                "enum": [
                  "yes",
                  "no",
                  "not needed"
                ],
                "description": "Whether the panel displays individual data points"
              },
              "decision": {
                "type": "string",
                "enum": [
                  "PASS",
                  "FAIL"
                ],
                "description": "Panel-level pass/fail verdict on whether individual data points are shown where average values are displayed"
              },
              "explanation": {
                "type": "string",
                "description": "Short explanation of the decision"
              }
            },
            "required": [
              "panel_label",
              "plot",
              "individual_values",
              "decision",
              "explanation"
            ],
            "additionalProperties": false
          }
        },
        "error-bars-defined": {
          "type": "array",
          "items": {
            "type": "object",
            "properties": {
              "panel_label": {
                "type": "string",
                "description": "Label of the panel (e.g., A, B, C)"
              },
              "error_bar_on_figure": {
                "type": "string",
                "enum": [
                  "yes",
                  "no"
                ],
                "description": "Whether error bars are present"
              },
              "error_bar_defined_in_caption": {
                "type": "string",
                "enum": [
                  "yes",
                  "no",
                  "not needed"
                ],
                "description": "Whether error bars are defined in caption"
              },
              "from_the_caption": {
                "type": "string",
                "description": "Text from caption describing error bars, when error bars are present, leave empty if no definition is found, or 'not needed' if error bars are not applicable"
              },
              "Decision_and_explanation": {
                "type": "string",
                "description": "Panel-level verdict and brief rationale (PASS or FAIL) on whether error bars or box-plot whiskers are adequately defined; use 'not needed' when error_bar_on_figure is 'no'"
              }
            },
            "required": [
              "panel_label",
              "error_bar_on_figure",
              "error_bar_defined_in_caption",
              "from_the_caption",
              "Decision_and_explanation"
            ],
            "additionalProperties": false
          }
        }
      },
      "required": [
        "micrograph-scale-bar",
        "individual-data-points",
        "error-bars-defined"
      ],
      "additionalProperties": false
    },
    "strict": true
  }
}
