{
  "format": {
    "type": "json_schema",
    "name": "do-fig-checklist-cm",
    "schema": {
      "type": "object",
      "properties": {
        "micrograph-scale-bar": {
          "type": "array",
          "items": {
            "type": "object",
            "properties": {
              "panel_label": {
                "type": "string",
                "description": "Label of the panel (e.g., A, B, C)"
              },
              "micrograph": {
                "type": "string",
                "enum": [
                  "yes",
                  "no"
                ],
                "description": "Whether the panel contains a micrograph or microscopic image"
              },
              "scale_bar_on_image": {
                "type": "string",
                "enum": [
                  "yes",
                  "no",
                  "not_applicable"
                ],
                "description": "Whether there is a scale bar present on the micrograph; not_applicable for a panel that is not a micrograph"
              },
              "scale_bar_defined_in_caption": {
                "type": "string",
                "enum": [
                  "yes",
                  "no",
                  "not_applicable"
                ],
                "description": "Whether the scale bar is defined in the caption; not_applicable for a panel that is not a micrograph"
              },
              "from_the_caption": {
                "type": "string",
                "description": "The exact text from the caption that defines the scale bar; leave empty if none is found or the panel is not a micrograph"
              },
              "scale_bar_defined_in_image": {
                "type": "string",
                "enum": [
                  "yes",
                  "no",
                  "not_applicable"
                ],
                "description": "Whether the scale bar is defined in the image; not_applicable for a panel that is not a micrograph"
              },
              "from_the_image": {
                "type": "string",
                "description": "The exact text from the image that defines the scale bar; leave empty if none is found or the panel is not a micrograph"
              }
            },
            "required": [
              "panel_label",
              "micrograph",
              "scale_bar_on_image",
              "scale_bar_defined_in_caption",
              "from_the_caption",
              "scale_bar_defined_in_image",
              "from_the_image"
            ],
            "additionalProperties": false
          }
        },
        "image-annotation-defined": {
          "type": "array",
          "items": {
            "type": "object",
            "properties": {
              "panel_label": {
                "type": "string",
                "description": "Label of the panel (e.g., A, B, C)"
              },
              "image_data": {
                "type": "string",
                "enum": [
                  "yes",
                  "no"
                ],
                "description": "Whether the panel is an image, a picture of a microscopic sample, macroscopic sample"
              },
              "any_annotation_present_on_image": {
                "type": "string",
                "enum": [
                  "yes",
                  "no"
                ],
                "description": "Whether the image is annotated with any symbols, arrows, lines, etc."
              },
              "annotation_description_on_image": {
                "type": "array",
                "items": {
                  "type": "string"
                },
                "description": "This is the description of the detected annotations predicted by model or expected output. Eg. 'red circle', 'white arrow', 'red arrowhead'"
              },
              "annotation_defined_in_caption": {
                "type": "array",
                "items": {
                  "type": "string",
                  "enum": [
                    "yes",
                    "no"
                  ]
                },
                "description": "Whether the annotation is mentioned in the figure caption"
              },
              "from_the_caption": {
                "type": "array",
                "items": {
                  "type": "string"
                },
                "description": "Text from caption describing annotation, when symbols are present"
              }
            },
            "required": [
              "panel_label",
              "image_data",
              "any_annotation_present_on_image",
              "annotation_description_on_image",
              "annotation_defined_in_caption",
              "from_the_caption"
            ],
            "additionalProperties": false
          }
        },
        "single-channel-for-overlay": {
          "type": "array",
          "items": {
            "type": "object",
            "properties": {
              "panel_label": {
                "type": "string",
                "description": "Label of the panel (e.g., A, B, C)"
              },
              "multicolored_overlay_micrograph": {
                "type": "string",
                "enum": [
                  "yes",
                  "no"
                ],
                "description": "Whether the panel shows a multicolored overlay microscopy image"
              },
              "overlay_channels": {
                "type": "array",
                "items": {
                  "type": "string"
                },
                "description": "Each channel merged in the overlay, briefly, by colour and what it shows (e.g. 'green: phalloidin (actin)'); empty when there is no overlay"
              },
              "number_of_channels_in_overlay": {
                "anyOf": [
                  {
                    "type": "integer",
                    "minimum": 0
                  },
                  {
                    "type": "string",
                    "enum": [
                      "not_applicable"
                    ]
                  }
                ],
                "description": "Number of distinct channels merged in the overlay image; not_applicable for a panel with no overlay"
              },
              "number_of_single_channel_images_shown": {
                "anyOf": [
                  {
                    "type": "integer",
                    "minimum": 0
                  },
                  {
                    "type": "string",
                    "enum": [
                      "not_applicable"
                    ]
                  }
                ],
                "description": "Number of single-channel images shown for the overlay in this panel; not_applicable for a panel with no overlay"
              },
              "all_channels_shown_separately": {
                "type": "string",
                "enum": [
                  "yes",
                  "no",
                  "not_applicable"
                ],
                "description": "Whether all channels in the overlay are shown as separate single-channel images"
              }
            },
            "required": [
              "panel_label",
              "multicolored_overlay_micrograph",
              "overlay_channels",
              "number_of_channels_in_overlay",
              "number_of_single_channel_images_shown",
              "all_channels_shown_separately"
            ],
            "additionalProperties": false
          }
        },
        "individual-data-points": {
          "type": "array",
          "items": {
            "type": "object",
            "properties": {
              "panel_label": {
                "type": "string",
                "description": "Label of the panel (e.g., A, B, C)"
              },
              "plot": {
                "type": "string",
                "enum": [
                  "yes",
                  "no"
                ],
                "description": "Whether the panel is a plot"
              },
              "individual_values": {
                "type": "string",
                "enum": [
                  "yes",
                  "no",
                  "not_required",
                  "not_applicable"
                ],
                "description": "Whether the panel displays individual data points: not_required for a plot type that does not require them, not_applicable for a panel that is not a plot"
              },
              "decision": {
                "type": "string",
                "enum": [
                  "PASS",
                  "FAIL",
                  "not_applicable"
                ],
                "description": "Panel-level verdict on whether individual data points are shown where average values are displayed; not_applicable for a panel that is not a plot"
              },
              "explanation": {
                "type": "string",
                "description": "Short explanation of the decision"
              }
            },
            "required": [
              "panel_label",
              "plot",
              "individual_values",
              "decision",
              "explanation"
            ],
            "additionalProperties": false
          }
        },
        "error-bars-defined": {
          "type": "array",
          "items": {
            "type": "object",
            "properties": {
              "panel_label": {
                "type": "string",
                "description": "Label of the panel (e.g., A, B, C)"
              },
              "is_a_plot": {
                "type": "string",
                "enum": [
                  "yes",
                  "no"
                ],
                "description": "Whether the panel is a plot"
              },
              "error_bar_on_figure": {
                "type": "string",
                "enum": [
                  "yes",
                  "no",
                  "not_applicable"
                ],
                "description": "Whether error bars are present; not_applicable for a panel that is not a plot"
              },
              "error_bar_defined_in_caption": {
                "type": "string",
                "enum": [
                  "yes",
                  "no",
                  "not_required",
                  "not_applicable"
                ],
                "description": "Whether error bars are defined in caption; not_required for a plot without error bars, not_applicable for a panel that is not a plot"
              },
              "from_the_caption": {
                "type": "string",
                "description": "Text from caption describing error bars, when error bars are present; leave empty if no definition is found or the panel has no error bars"
              },
              "decision": {
                "type": "string",
                "enum": [
                  "PASS",
                  "FAIL",
                  "not_applicable"
                ],
                "description": "Panel-level verdict on whether error bars or box-plot whiskers are adequately defined; PASS for a plot without error bars, not_applicable for a panel that is not a plot"
              },
              "explanation": {
                "type": "string",
                "description": "Brief rationale for the decision"
              }
            },
            "required": [
              "panel_label",
              "is_a_plot",
              "error_bar_on_figure",
              "error_bar_defined_in_caption",
              "from_the_caption",
              "decision",
              "explanation"
            ],
            "additionalProperties": false
          }
        },
        "plot-axis-units": {
          "type": "array",
          "items": {
            "type": "object",
            "properties": {
              "panel_label": {
                "type": "string",
                "description": "Label of the panel (e.g., A, B, C)"
              },
              "is_a_plot_with_axes": {
                "type": "string",
                "enum": [
                  "yes",
                  "no"
                ],
                "description": "Whether the panel is a plot of quantitative data with drawn axes; pie charts, heat maps and sequence alignments are not"
              },
              "units_provided": {
                "type": "array",
                "items": {
                  "type": "object",
                  "properties": {
                    "axis": {
                      "type": "string",
                      "enum": [
                        "x",
                        "y",
                        "z"
                      ],
                      "description": "The axis to be labeled"
                    },
                    "answer": {
                      "type": "string",
                      "enum": [
                        "yes",
                        "no",
                        "not_required"
                      ],
                      "description": "Whether the units are provided"
                    }
                  },
                  "required": [
                    "axis",
                    "answer"
                  ],
                  "additionalProperties": false
                }
              },
              "unit_definition_as_provided": {
                "type": "array",
                "items": {
                  "type": "object",
                  "properties": {
                    "axis": {
                      "type": "string",
                      "enum": [
                        "x",
                        "y",
                        "z"
                      ],
                      "description": "The axis to be labeled"
                    },
                    "definition": {
                      "type": "string",
                      "description": "A description or quote the text of the caption that defines the units"
                    }
                  },
                  "required": [
                    "axis",
                    "definition"
                  ],
                  "additionalProperties": false
                }
              },
              "decision": {
                "type": "string",
                "enum": [
                  "PASS",
                  "FAIL",
                  "not_applicable"
                ],
                "description": "Panel-level verdict: PASS if all required axes have adequate units, FAIL if any required axis lacks units, not_applicable if the panel is not a quantitative plot"
              },
              "explanation": {
                "type": "array",
                "items": {
                  "type": "object",
                  "properties": {
                    "axis": {
                      "type": "string",
                      "enum": [
                        "x",
                        "y",
                        "z"
                      ],
                      "description": "The axis to be labeled"
                    },
                    "explanation": {
                      "type": "string",
                      "description": "Explanation for why the units are missing"
                    }
                  },
                  "required": [
                    "axis",
                    "explanation"
                  ],
                  "additionalProperties": false
                }
              }
            },
            "required": [
              "panel_label",
              "is_a_plot_with_axes",
              "units_provided",
              "unit_definition_as_provided",
              "decision",
              "explanation"
            ],
            "additionalProperties": false
          }
        },
        "plot-gap-labeling": {
          "type": "array",
          "items": {
            "type": "object",
            "properties": {
              "panel_label": {
                "type": "string",
                "description": "Label of the panel (e.g., A, B, C)"
              },
              "is_a_plot_with_axes": {
                "type": "string",
                "enum": [
                  "yes",
                  "no"
                ],
                "description": "Whether the panel contains a quantitative plot with axes"
              },
              "tick_sequence_anomaly": {
                "type": "string",
                "enum": [
                  "yes",
                  "no",
                  "not_applicable"
                ],
                "description": "Whether tick labels show an anomalous jump or skip suggesting an axis gap"
              },
              "gap_visually_marked": {
                "type": "string",
                "enum": [
                  "yes",
                  "no",
                  "not_required",
                  "not_applicable"
                ],
                "description": "Whether a detected gap/break is visually marked on the axis; not_required for a plot with no anomaly, not_applicable for a panel that is not a plot"
              },
              "decision": {
                "type": "string",
                "enum": [
                  "PASS",
                  "FAIL",
                  "not_applicable"
                ],
                "description": "Panel-level verdict: FAIL only when a tick-sequence anomaly is present and not visually marked; not_applicable if not a plot"
              },
              "explanation": {
                "type": "string",
                "description": "Brief description of the unlabeled gap when decision is FAIL; empty string otherwise"
              }
            },
            "required": [
              "panel_label",
              "is_a_plot_with_axes",
              "tick_sequence_anomaly",
              "gap_visually_marked",
              "decision",
              "explanation"
            ],
            "additionalProperties": false
          }
        },
        "stat-significance-level": {
          "type": "array",
          "items": {
            "type": "object",
            "properties": {
              "panel_label": {
                "type": "string",
                "description": "Label of the panel (e.g., A, B, C)"
              },
              "is_a_plot": {
                "type": "string",
                "enum": [
                  "yes",
                  "no"
                ],
                "description": "Whether the figure is a plot"
              },
              "significance_level_symbols_on_image": {
                "type": "array",
                "items": {
                  "type": "string"
                },
                "description": "Significance level symbols on the image"
              },
              "symbols_defined": {
                "type": "array",
                "items": {
                  "type": "string",
                  "enum": [
                    "yes",
                    "no"
                  ]
                },
                "description": "Whether each significance level symbol is defined in the image and/or caption"
              },
              "symbol_definition": {
                "type": "array",
                "items": {
                  "type": "string"
                },
                "description": "Defining text for each significance symbol, transcribed from the image and/or caption; empty string if undefined"
              },
              "decision": {
                "type": "string",
                "enum": [
                  "PASS",
                  "FAIL",
                  "not_applicable"
                ],
                "description": "Panel-level verdict on whether significance levels are adequately defined; not_applicable when not a plot"
              },
              "explanation": {
                "type": "string",
                "description": "Brief rationale for the decision; empty string when decision is N/A"
              }
            },
            "required": [
              "panel_label",
              "is_a_plot",
              "significance_level_symbols_on_image",
              "symbols_defined",
              "symbol_definition",
              "decision",
              "explanation"
            ],
            "additionalProperties": false
          }
        },
        "stat-test": {
          "type": "array",
          "items": {
            "type": "object",
            "properties": {
              "panel_label": {
                "type": "string",
                "description": "Label of the panel (e.g., A, B, C)"
              },
              "is_a_plot": {
                "type": "string",
                "enum": [
                  "yes",
                  "no"
                ],
                "description": "Whether the figure is a plot"
              },
              "statistical_significance_claim": {
                "type": "string",
                "enum": [
                  "yes",
                  "no",
                  "not_applicable"
                ],
                "description": "Whether the panel marks or states statistical significance (p-values, significance symbols, a claim of a significant difference); not_applicable for a panel that is not a plot"
              },
              "statistical_test_mentioned": {
                "type": "string",
                "enum": [
                  "yes",
                  "no",
                  "not_required",
                  "not_applicable"
                ],
                "description": "Whether the statistical test is mentioned; not_required for a plot that needs no test, not_applicable for a panel that is not a plot"
              },
              "from_the_caption": {
                "type": "string",
                "description": "Extracted text describing the statistical test when mentioned"
              },
              "decision": {
                "type": "string",
                "enum": [
                  "PASS",
                  "FAIL",
                  "not_applicable"
                ],
                "description": "Panel-level verdict on whether the statistical test is adequately reported; not_applicable for a panel that is not a plot"
              },
              "explanation": {
                "type": "string",
                "description": "Short explanation of the decision, especially when the test is missing"
              }
            },
            "required": [
              "panel_label",
              "is_a_plot",
              "statistical_significance_claim",
              "statistical_test_mentioned",
              "from_the_caption",
              "decision",
              "explanation"
            ],
            "additionalProperties": false
          }
        },
        "replication-reporting": {
          "type": "array",
          "items": {
            "type": "object",
            "properties": {
              "panel_label": {
                "type": "string",
                "description": "Label of the panel (e.g., A, B, C)"
              },
              "involves_replicates": {
                "type": "string",
                "enum": [
                  "yes",
                  "no",
                  "unclear"
                ],
                "description": "Whether the panel presents data derived from replicated observations"
              },
              "replicate_statements": {
                "type": "array",
                "items": {
                  "type": "string"
                },
                "description": "Verbatim statements from the caption or panel about n-number or replicate type"
              },
              "n_reported": {
                "type": "string",
                "enum": [
                  "yes",
                  "no",
                  "not_applicable"
                ],
                "description": "Whether the number of replicates is reported"
              },
              "n_value_min": {
                "anyOf": [
                  {
                    "type": "integer",
                    "minimum": 1
                  },
                  {
                    "type": "string",
                    "enum": [
                      "not_reported",
                      "not_applicable"
                    ]
                  }
                ],
                "description": "Minimum reported n-number; use the lower bound for ranges; not_reported or not_applicable when no numeric n applies"
              },
              "replicate_type_reported": {
                "type": "string",
                "enum": [
                  "yes",
                  "no",
                  "not_applicable"
                ],
                "description": "Whether the type of replicate is reported"
              },
              "replicate_type": {
                "type": "string",
                "description": "Verbatim replication type description from the figure caption; empty when none is reported or the check does not apply"
              },
              "decision": {
                "type": "string",
                "enum": [
                  "PASS",
                  "FAIL",
                  "not_applicable"
                ],
                "description": "Panel-level verdict for replication reporting completeness; not_applicable for a panel that does not involve replicates"
              },
              "explanation": {
                "type": "string",
                "description": "Short explanation of the decision"
              }
            },
            "required": [
              "panel_label",
              "involves_replicates",
              "replicate_statements",
              "n_reported",
              "n_value_min",
              "replicate_type_reported",
              "replicate_type",
              "decision",
              "explanation"
            ],
            "additionalProperties": false
          }
        },
        "panel-image-matches-caption": {
          "type": "array",
          "items": {
            "type": "object",
            "properties": {
              "panel_label": {
                "type": "string",
                "description": "Label of the panel (e.g., A, B, C)"
              },
              "image_matches_caption": {
                "type": "string",
                "enum": [
                  "yes",
                  "no",
                  "not_applicable"
                ],
                "description": "Whether the panel image content matches what is described in the figure caption"
              },
              "discrepancies": {
                "type": "string",
                "description": "Description of any discrepancies between the panel image and caption, or empty string if no discrepancies"
              }
            },
            "required": [
              "panel_label",
              "image_matches_caption",
              "discrepancies"
            ],
            "additionalProperties": false
          }
        }
      },
      "required": [
        "micrograph-scale-bar",
        "image-annotation-defined",
        "single-channel-for-overlay",
        "individual-data-points",
        "error-bars-defined",
        "plot-axis-units",
        "plot-gap-labeling",
        "stat-significance-level",
        "stat-test",
        "replication-reporting",
        "panel-image-matches-caption"
      ],
      "additionalProperties": false
    },
    "strict": true
  }
}
